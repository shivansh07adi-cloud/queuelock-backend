PORT=4000

# In production, set this to your deployed frontend's URL (e.g.
# https://flashbook.vercel.app). Leave unset/as "*" for local development.
CORS_ORIGIN=*

# PostgreSQL (Supabase connection string works fine here)
DATABASE_URL=postgresql://user:password@localhost:5432/flashbook
PG_POOL_MAX=20

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=1h

# Redis - needed from Phase 2 onward. Use Upstash's free tier (get the URL from
# their dashboard, it looks like redis://default:xxxx@xxxx.upstash.io:6379) or
# run Redis locally via Docker: docker run -p 6379:6379 -d redis
REDIS_URL=redis://localhost:6379
